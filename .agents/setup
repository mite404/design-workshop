#!/usr/bin/env bash
set -euo pipefail

readonly PNPM_VERSION="10.33.0"

run_step() {
  local description="$1"
  shift

  printf '\n==> %s\n' "$description"
  time "$@"
}

if [[ "$(pnpm --version 2>/dev/null)" != "$PNPM_VERSION" ]]; then
  run_step "Installing pnpm $PNPM_VERSION" npm install --global "pnpm@$PNPM_VERSION"
fi

run_step "Installing locked pnpm dependencies" pnpm install --frozen-lockfile
run_step "Installing the Playwright Chromium browser" \
  pnpm --filter storybook exec playwright install chromium
